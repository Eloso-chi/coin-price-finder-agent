{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Terapeak: verify visible terminal (no services)",
      "type": "process",
      "command": "wsl.exe",
      "args": [
        "-d",
        "Ubuntu-24.04",
        "--",
        "bash",
        "-c",
        "test -t 0 && echo TERMINAL_INPUT_READY_PRESS_ENTER && read -r && echo TERMINAL_HANDOFF_OK"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Terapeak: H operator (visible login and loop)",
      "type": "process",
      "command": "wsl.exe",
      "args": [
        "-d",
        "Ubuntu-24.04",
        "--",
        "bash",
        "scripts/terapeak-operator.sh",
        "--loop"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
