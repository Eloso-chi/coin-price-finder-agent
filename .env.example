PCGS_API_KEY=
PCGS_BASE_URL=https://api.pcgs.com/publicapi

GREYSHEET_API_TOKEN=
GREYSHEET_API_KEY=
GREYSHEET_BASE_URL=https://cpgpublicapiv2.greysheet.com/api

EBAY_APP_ID=
EBAY_CLIENT_SECRET=
EBAY_CERT_ID=
EBAY_FINDING_ENDPOINT=https://svcs.ebay.com/services/search/FindingService/v1
EBAY_GLOBAL_ID=EBAY-US
EBAY_ENTRIES_PER_PAGE=50
EBAY_TIMEOUT_MS=10000
EBAY_CACHE_TTL_MS=3600000
EBAY_US_MIN_COMPS=8
EBAY_THROTTLE_MS=1100

GOLDAPI_KEY=
GOLDAPI_BASE_URL=https://www.goldapi.io/api
METALS_API_KEY=
METALS_API_BASE_URL=https://metals-api.com/api
NUMISTA_API_KEY=
METALS_CACHE_TTL_MS=2700000
METALS_POLL_MS=1800000

# Authentication and admin access
ADMIN_API_KEY=
ADMIN_BOOTSTRAP_USERNAME=
JWT_SECRET=

# Persistent storage (optional; file-only when unset)
CACHE_DIR=./cache
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DB=coinprice

# Crash/ops alerting through Azure Communication Services Email (optional)
COMMUNICATION_CONNECTION_STRING=
ALERT_EMAIL_TO=
ALERT_FROM_EMAIL=alerts@coinpricefinder.app
LOG_LEVEL=info

# Azure Blob Storage for Terapeak CSVs (#99, #106)
TERAPEAK_BLOB_ACCOUNT=
TERAPEAK_BLOB_CONTAINER=terapeak-csvs
TERAPEAK_DATA_DIR=data/terapeak
# How often to re-import from blob (ms, default 30 min)
# BLOB_REIMPORT_MS=1800000

# Greysheet history refresh interval in days (default 3)
# GS_REFRESH_INTERVAL_DAYS=3

# PCGS prefetch scheduler (optional)
# PCGS_PREFETCH_ENABLED=true
# PREFETCH_HOUR_PT=23
# PREFETCH_THROTTLE_MS=1000
# PREFETCH_RESERVE=10
# PCGS_PREFETCH_OBSERVED_LIMIT=100

# Auction history refresh tuning (optional)
# APR_DATE_WINDOW_YEARS=3
# APR_FRESHNESS_DAYS=30

# Remote freshness sync (#260) -- used by scripts/sync-terapeak-meta.js to
# pull data/terapeak-meta.json from the live Azure server so the local
# freshness report reflects what the scraper has actually done. Required
# for `npm run sync:meta` and `npm run freshness`. ADMIN_API_KEY must
# match the server's ADMIN_API_KEY exactly.
# APP_URL=https://coinpricefinder-<id>.azurewebsites.net
# ADMIN_API_KEY=

PORT=3000

# LLM conversational pricing (#293H) -- disabled unless all values are set.
# LLM_PROVIDER=azure-openai
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_API_KEY=
